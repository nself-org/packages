{
  "name": "nself-packages",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "prepare": "lefthook install",
    "typecheck": "tsc --noEmit --project tsconfig.base.json",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "graphql-codegen --config codegen.ts --check",
    "codegen:live": "graphql-codegen --config codegen.ts",
    "test": "turbo run test",
    "check:licenses": "license-checker --start . --onlyAllow 'MIT;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;CC0-1.0;CC-BY-4.0;Python-2.0;Unlicense;0BSD' --excludePrivatePackages"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.1.2",
    "@graphql-codegen/client-preset": "^6.0.1",
    "@types/node": "^22",
    "expo-doctor": "^1.19.10",
    "graphql": "^16.9.0",
    "lefthook": "^2.1.9",
    "license-checker": "^25.0.1",
    "turbo": "^2",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1",
      "vite": ">=6.4.3",
      "dompurify": ">=3.4.13",
      "uuid": ">=11.1.1",
      "@opentelemetry/core": ">=2.8.0",
      "postcss": ">=8.5.18",
      "@xmldom/xmldom": ">=0.8.13",
      "js-yaml": ">=4.3.1",
      "react": "19.0.0",
      "react-dom": "19.0.0",
      "immutable": ">=5.1.8",
      "nanoid": ">=3.3.18",
      "shell-quote": ">=1.9.0",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@3": "5.0.9",
      "brace-expansion@4": "5.0.9",
      "brace-expansion@5": "5.0.9",
      "undici": "^7.29.0",
      "vitest": ">=3.2.6",
      "browserslist@<4.28.7": "^4.28.7"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2025-71330",
        "CVE-2025-71329"
      ]
    }
  }
}
