{
  "name": "@nself-web/ui",
  "version": "0.1.0",
  "description": "Shared UI components for nSelf web marketing sites",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nself-org/web.git",
    "directory": "packages/ui"
  },
  "homepage": "https://nself.org",
  "bugs": {
    "url": "https://github.com/nself-org/web/issues"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external react,react-dom && node -e \"const fs=require('fs');['dist/index.mjs','dist/index.js'].forEach(f=>{const c=fs.readFileSync(f,'utf8');if(!c.startsWith(\\\"'use client'\\\"))fs.writeFileSync(f,\\\"'use client';\\\\n\\\"+c)})\"",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "clsx": "^2",
    "next-themes": "^0.4.6",
    "tailwind-merge": "^2"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@storybook/react": "^10.3.5",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "eslint": "^9.32.0",
    "jsdom": "^25",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8",
    "vitest": "^1"
  }
}
