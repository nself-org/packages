{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // tsup builds this package, so rootDir only scopes the typecheck. The
    // base paths resolve @nself/errors to its src, which sits beside ui/.
    "rootDir": "..",
    "outDir": "dist",
    "jsx": "react-jsx",
    "composite": false,
    "incremental": false,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src"]
}
