{
  "name": "@nself/ui",
  "version": "0.1.0",
  "description": "nSelf shared design system — AsyncScreen 7-state wrapper, shadcn/Radix primitives, nSelf Tailwind preset",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/theme/preset.ts"
  },
  "private": false,
  "license": "MIT",
  "scripts": {
    "build": "tsup src/index.ts src/theme/preset.ts --format esm,cjs --dts --external react,react-dom,@nself/errors,@nself/i18n,@nself/observability",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "pnpm exec storybook dev -p 6008",
    "storybook:build": "pnpm exec storybook build"
  },
  "dependencies": {
    "clsx": "^2",
    "tailwind-merge": "^2"
  },
  "peerDependencies": {
    "@nself/errors": "workspace:*",
    "@nself/i18n": "workspace:*",
    "@nself/observability": "workspace:*",
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "@nself/observability": {
      "optional": true
    },
    "@nself/i18n": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nself/errors": "workspace:*",
    "@nself/i18n": "workspace:*",
    "@nself/observability": "workspace:*",
    "@storybook/react": "^8",
    "@storybook/react-vite": "^8",
    "@storybook/addon-essentials": "^8",
    "@storybook/addon-a11y": "^8",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "jsdom": "^25",
    "tsup": "^8",
    "typescript": "^6.0.3",
    "vitest": "^2.1.9"
  }
}
