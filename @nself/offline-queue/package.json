{
  "name": "@nself/offline-queue",
  "version": "0.0.1",
  "description": "Platform-agnostic offline mutation queue with MMKV/IndexedDB/Tauri/Memory adapters",
  "private": false,
  "license": "MIT",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./adapters": "./src/adapters/index.ts",
    "./adapters/mmkv": "./src/adapters/mmkv.ts",
    "./adapters/idb": "./src/adapters/idb.ts",
    "./adapters/tauri-fs": "./src/adapters/tauri-fs.ts",
    "./adapters/memory": "./src/adapters/memory.ts"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react-native-mmkv": ">=2.0.0",
    "@tauri-apps/plugin-fs": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-mmkv": { "optional": true },
    "@tauri-apps/plugin-fs": { "optional": true }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.6",
    "vitest": "^3.2.6",
    "fake-indexeddb": "^6.0.0"
  }
}
