    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18",
    "@vitest/coverage-v8": "^3.2.6",
    "jsdom": "^29.1.1",
    "react": "^18",
    "react-dom": "^18.3.1",
    "vitest": "^3.2.6"
