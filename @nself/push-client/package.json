{
  "name": "@nself/push-client",
  "version": "0.1.0",
  "description": "Unified push notification client for nSelf \u2014 web (Web Push API) and React Native (Expo Notifications) with GraphQL backend registration",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "private": false,
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@nself/errors": "workspace:*",
    "@nself/native-bridge": "workspace:*",
    "@nself/graphql-client": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.2.6",
    "typescript": "^5"
  },
  "peerDependencies": {
    "@nself/errors": "workspace:*",
    "@nself/native-bridge": "workspace:*",
    "@nself/graphql-client": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@nself/native-bridge": {
      "optional": true
    },
    "@nself/graphql-client": {
      "optional": true
    }
  }
}
